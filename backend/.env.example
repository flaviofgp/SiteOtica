# Banco de dados — Postgres.
# Local: suba o docker-compose.yml na raiz do projeto (docker compose up -d)
# e use a URL abaixo, que já bate com as credenciais definidas nele.
DATABASE_URL="postgresql://traco:traco@localhost:5432/traco_optica"
# Em produção (Azure Database for PostgreSQL), o script infra/azure-deploy.sh
# já configura essa variável automaticamente no App Service — você não
# precisa copiar esse .env para lá.

# Autenticação
JWT_SECRET="troque-esta-chave-por-uma-string-aleatoria-longa"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3333
CORS_ORIGIN="http://localhost:5173"

# Pagamento: "mock" (padrão, não cobra nada de verdade) ou "mercadopago"
PAYMENT_PROVIDER=mock
MERCADOPAGO_ACCESS_TOKEN=
